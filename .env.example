# OpenAI-compatible vLLM endpoint (runs on localhost:8000 in Kaggle/Colab)
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ
LLM_TIMEOUT_SECONDS=60

# FastAPI server port
PORT=7860

# Optional: set to true to use deterministic fallback if LLM is offline
ALLOW_PLANNER_FALLBACK=true
